+// ***************************************************************************
+// ***************************************************************************
+// NCO + complex mixer for the DATV beacon.
+//
+// Multiplies the complex input by exp(j * phase), where the phase advances
+// by phase_inc (full turn = 2^32) for every valid input sample. The sine and
+// cosine are read from a quarter wave table (block RAM) addressed with the
+// 12 MSBs of the phase (spurs < -72 dBc); the mixer uses 4 DSP slices.
+// The phase is held at zero while disabled.
+//
+// The table is generated by the script in the comment at the end of this
+// file.
+// ***************************************************************************
+// ***************************************************************************
+
+`timescale 1ns/100ps
+
+module datv_nco_mixer (
+
+  input                   clk,
+  input                   rst,
+
+  input                   enable,
+  input       [31:0]      phase_inc,
+
+  input                   in_valid,
+  input       [15:0]      in_i,
+  input       [15:0]      in_q,
+
+  output reg              out_valid = 'd0,
+  output reg  [15:0]      out_i = 'd0,
+  output reg  [15:0]      out_q = 'd0,
+  output reg              out_sat = 'd0
+);
+
+  // quarter wave table, sin(pi/2 * (k + 0.5) / 1024) * 32767
