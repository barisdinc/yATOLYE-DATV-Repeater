+    s2_cos <= rom[s1_addr_c];
+    s2_neg_s <= s1_neg_s;
+    s2_neg_c <= s1_neg_c;
+    s2_i <= s1_i;
+    s2_q <= s1_q;
+  end
+
+  always @(posedge clk) begin
+    s3_valid <= s2_valid;
+    s3_sin <= (s2_neg_s == 1'b1) ? -{1'b0, s2_sin} : {1'b0, s2_sin};
+    s3_cos <= (s2_neg_c == 1'b1) ? -{1'b0, s2_cos} : {1'b0, s2_cos};
+    s3_i <= s2_i;
+    s3_q <= s2_q;
+  end
+
+  // (i + jq) * (cos + jsin)
+
+  always @(posedge clk) begin
+    s4_valid <= s3_valid;
+    s4_ic <= s3_i * s3_cos;
+    s4_qs <= s3_q * s3_sin;
+    s4_is <= s3_i * s3_sin;
+    s4_qc <= s3_q * s3_cos;
+  end
+
+  always @(posedge clk) begin
+    s5_valid <= s4_valid;
+    s5_re <= s4_ic - s4_qs;
+    s5_im <= s4_is + s4_qc;
+  end
+
+  // scale by 2^-15 (round half up) and saturate to 16 bits
+
+  assign out_re_s = s5_re[32:15] + s5_re[14];
+  assign out_im_s = s5_im[32:15] + s5_im[14];
+  assign out_sat_re_s = (out_re_s[17:15] != {3{out_re_s[17]}});
+  assign out_sat_im_s = (out_im_s[17:15] != {3{out_im_s[17]}});
+
+  always @(posedge clk) begin
+    out_valid <= s5_valid;
+    out_sat <= s5_valid & (out_sat_re_s | out_sat_im_s);
+    if (s5_valid == 1'b1) begin
+      out_i <= (out_sat_re_s == 1'b1) ? {out_re_s[17], {15{~out_re_s[17]}}} : out_re_s[15:0];
+      out_q <= (out_sat_im_s == 1'b1) ? {out_im_s[17], {15{~out_im_s[17]}}} : out_im_s[15:0];
+    end
+  end
+
+endmodule
