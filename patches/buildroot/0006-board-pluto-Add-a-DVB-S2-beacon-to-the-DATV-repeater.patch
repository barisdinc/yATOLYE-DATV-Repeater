diff --git a/board/pluto/datv.conf b/board/pluto/datv.conf
index ed07830eed..c9b0364fd0 100644
--- a/board/pluto/datv.conf
+++ b/board/pluto/datv.conf
@@ -18,7 +18,9 @@ tx_freq_mhz = 5760
 # Channel bandwidth in MHz (RX and TX analog filters), 0.2 - 20
 bandwidth_mhz = 10
 
-# Baseband sample rate in MSPS, 0 = auto (1.25 x bandwidth, min 2.5)
+# Baseband sample rate in MSPS, 0 = auto (1.25 x bandwidth, min 2.5; with the
+# beacon on, rounded up so that sample rate / 8 is a multiple of the symbol
+# rate)
 sample_rate_msps = 0
 
 # RX gain control: manual | slow_attack | fast_attack | hybrid
@@ -45,3 +47,43 @@ squelch_hang_ms = 500
 
 # Power detector averaging, time constant = 2^n samples (0 .. 24)
 power_avg_shift = 10
+
+# ---------------------------------------------------------------------------
+# Beacon: a DVB-S2 QPSK signal generated from a transport stream file and
+# transmitted at the lower edge of the output channel, next to (and
+# independent of) the relayed signal. It stays on when the squelch closes.
+# ---------------------------------------------------------------------------
+
+# 1 = beacon on, 0 = off (with enable = 0 and beacon = 1 only the beacon
+# is transmitted)
+beacon = 1
+
+# Transport stream (or any file ffmpeg can remux to MPEG-TS without
+# re-encoding), played in a loop. Its total bit rate must be below the TS
+# rate of the selected symbol rate / FEC, e.g. 333 kS/s 2/3 = 440 kbit/s.
+beacon_file = /usr/share/datv/atolye_beacon.ts
+
+# Symbol rate in kS/s, e.g. 333, 500, 1000 (33, 66, 333... mean 1/3 values)
+beacon_sr_ksps = 500
+
+# Code rate: 1/4 1/3 2/5 1/2 3/5 2/3 3/4 4/5 5/6 8/9 9/10
+beacon_fec = 2/3
+
+# Roll-off: 0.35, 0.25 or 0.20
+beacon_rolloff = 0.35
+
+# DVB-S2 pilots, 1 = on
+beacon_pilots = 0
+
+# Beacon RMS level in dBFS (DAC full scale), -60 .. -3. Peaks are ~6 dB
+# higher; the relayed signal adds on top of it.
+beacon_level_dbfs = -15
+
+# Offset of the beacon centre from tx_freq_mhz in kHz, or auto: lower edge
+# of the beacon at the lower edge of the channel (tx_freq - bandwidth / 2).
+# -3000 = 5757 MHz with the default 5760 MHz channel; a beacon right at the
+# channel edge is harder to decode for some receivers.
+beacon_offset_khz = -3000
+
+# Service name shown by the receiver (no spaces)
+beacon_name = yATOLYE-BEACON
diff --git a/board/pluto/datv_beacon b/board/pluto/datv_beacon
new file mode 100755
index 0000000000..269cdee48a
--- /dev/null
+++ b/board/pluto/datv_beacon
@@ -0,0 +1,53 @@
+#!/bin/sh
+#
+# yATOLYE DATV repeater - DVB-S2 beacon control
+#
+# Starts or stops the beacon without touching the persistent configuration:
+# the settings are written to /var/run/datv.conf (RAM, read after
+# /etc/datv.conf and /mnt/jffs2/datv.conf) and the repeater is restarted.
+#
+# usage: datv_beacon start [file] [symbol rate kS/s] [fec]
+#        datv_beacon stop
+#        datv_beacon status
+
+CONF_RUN=/var/run/datv.conf
+
+usage() {
+	echo "usage: $0 start [file] [symbol rate kS/s] [fec]"
+	echo "       $0 stop"
+	echo "       $0 status"
+	echo
+	echo "e.g.   $0 start /tmp/my_beacon.ts 500 3/4"
+	exit 1
+}
+
+case "$1" in
+	start)
+		file=$2
+		if [ -n "$file" ]; then
+			[ -r "$file" ] || { echo "$file: not found"; exit 1; }
+			case "$file" in
+				/*) ;;
+				*) file=$(pwd)/$file ;;
+			esac
+		fi
+		{
+			echo "[DATV]"
+			echo "beacon = 1"
+			[ -n "$file" ] && echo "beacon_file = $file"
+			[ -n "$3" ] && echo "beacon_sr_ksps = $3"
+			[ -n "$4" ] && echo "beacon_fec = $4"
+		} > $CONF_RUN
+		exec /usr/sbin/datv_repeater restart
+		;;
+	stop)
+		printf "[DATV]\nbeacon = 0\n" > $CONF_RUN
+		exec /usr/sbin/datv_repeater restart
+		;;
+	status)
+		exec /usr/sbin/datv_repeater status
+		;;
+	*)
+		usage
+		;;
+esac
diff --git a/board/pluto/datv_repeater b/board/pluto/datv_repeater
index d3146c4791..02158010b9 100755
--- a/board/pluto/datv_repeater
+++ b/board/pluto/datv_repeater
@@ -3,12 +3,16 @@
 # yATOLYE DATV repeater control
 #
 # Configures the AD936x (RX/TX LO, bandwidth, gain) and the axi_datv_xpdr
-# FPGA core from /etc/datv.conf (overridden by /mnt/jffs2/datv.conf).
+# FPGA core from /etc/datv.conf (overridden by /mnt/jffs2/datv.conf and
+# /var/run/datv.conf, see datv_beacon), and runs the DVB-S2 beacon
+# (ffmpeg | dvbs2_tx -> TX DMA -> NCO) if enabled.
 #
 # usage: datv_repeater {start|stop|restart|status}
 
 CONF_DEFAULT=/etc/datv.conf
 CONF_USER=/mnt/jffs2/datv.conf
+# written by datv_beacon, not persistent
+CONF_RUN=/var/run/datv.conf
 
 PHY=ad9361-phy
 DDS=cf-ad9361-dds-core-lpc
@@ -22,6 +26,7 @@ REG_GAIN=0x044
 REG_SQ_THRESH=0x048
 REG_SQ_HANG=0x04C
 REG_AVG_SHIFT=0x050
+REG_BEACON_FREQ=0x054
 REG_STATUS=0x080
 REG_POWER=0x084
 REG_SAT_COUNT=0x088
@@ -37,6 +42,10 @@ STEP_PWR=1.0232929922807541
 # full-scale complex sinusoid of 12-bit samples: 2048^2
 PWR_FS=4194304
 
+BEACON_PID=/var/run/datv_beacon.pid
+BEACON_ARGS=/var/run/datv_beacon.args
+BEACON_LOG=/var/log/datv_beacon.log
+
 log() {
 	echo "datv: $*"
 	logger -t datv "$*"
@@ -101,19 +110,29 @@ load_conf() {
 	cfg_squelch_dbfs=-40
 	cfg_squelch_hang_ms=500
 	cfg_power_avg_shift=10
+	cfg_beacon=1
+	cfg_beacon_file=/usr/share/datv/atolye_beacon.ts
+	cfg_beacon_sr_ksps=500
+	cfg_beacon_fec=2/3
+	cfg_beacon_rolloff=0.35
+	cfg_beacon_pilots=0
+	cfg_beacon_level_dbfs=-15
+	cfg_beacon_offset_khz=-3000
+	cfg_beacon_name=yATOLYE-BEACON
 
 	CONF_USED=
-	for f in $CONF_DEFAULT $CONF_USER; do
+	for f in $CONF_DEFAULT $CONF_USER $CONF_RUN; do
 		[ -f $f ] || continue
 		CONF_USED="$CONF_USED $f"
 		# only plain key=value pairs of the [DATV] section, values limited
-		# to a safe character set so the result can be eval'd
+		# to a safe character set (no quotes, spaces, $ or ;) so the
+		# result can be eval'd
 		eval "$(awk '
 			{ sub(/\r$/, "") }
 			/^[ \t]*\[/ { sec = $0; gsub(/[][ \t]/, "", sec); next }
 			sec != "DATV" { next }
 			{ sub(/[#;].*$/, ""); gsub(/[ \t]/, "") }
-			/^[a-z_][a-z0-9_]*=[A-Za-z0-9_.+-]+$/ { print "cfg_" $0 }
+			/^[a-z_][a-z0-9_]*=[A-Za-z0-9_.+\/-]+$/ { print "cfg_" $0 }
 		' $f)"
 	done
 }
@@ -135,6 +154,48 @@ check_conf() {
 	in_range "$cfg_squelch_dbfs" -90 0 || die "squelch_dbfs must be -90 - 0"
 	in_range "$cfg_squelch_hang_ms" 0 60000 || die "squelch_hang_ms must be 0 - 60000"
 	in_range "$cfg_power_avg_shift" 0 24 || die "power_avg_shift must be 0 - 24"
+	in_range "$cfg_beacon" 0 1 || die "beacon must be 0 or 1"
+	[ "$cfg_beacon" = "1" ] || return 0
+	[ -r "$cfg_beacon_file" ] || die "beacon_file $cfg_beacon_file not found"
+	in_range "$cfg_beacon_sr_ksps" 25 4000 || die "beacon_sr_ksps must be 25 - 4000"
+	case "$cfg_beacon_fec" in
+		1/4|1/3|2/5|1/2|3/5|2/3|3/4|4/5|5/6|8/9|9/10) ;;
+		*) die "beacon_fec must be 1/4 1/3 2/5 1/2 3/5 2/3 3/4 4/5 5/6 8/9 or 9/10" ;;
+	esac
+	case "$cfg_beacon_rolloff" in
+		0.35|0.25|0.20|0.2) ;;
+		*) die "beacon_rolloff must be 0.35, 0.25 or 0.20" ;;
+	esac
+	in_range "$cfg_beacon_pilots" 0 1 || die "beacon_pilots must be 0 or 1"
+	in_range "$cfg_beacon_level_dbfs" -60 -3 || die "beacon_level_dbfs must be -60 - -3"
+	[ "$cfg_beacon_offset_khz" = "auto" ] || in_range "$cfg_beacon_offset_khz" -30000 30000 || \
+		die "beacon_offset_khz must be auto or -30000 - 30000"
+}
+
+# beacon symbol rate in S/s; integers ending in 3 or 6 (33, 66, 333, ...)
+# are the usual 1/3 and 2/3 kS/s rates
